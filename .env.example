# ============================================================
# JOBHUNT — configuración de búsqueda y scoring
# Copia este archivo a .env y ajusta a tu perfil.
# ============================================================

# ---------- PERFIL DEL CANDIDATO ----------
# Define quién eres. El score de compatibilidad se calcula contra ESTO.
PROFILE_TITLE=Tech Lead / Full-Stack Developer
# Años de experiencia (para comparar contra lo que exige la oferta)
PROFILE_YEARS_EXP=5

# Techs del perfil: lista separada por comas.
# Las primeras N_TECH_PRIMARY reciben más peso que las secundarias.
PROFILE_TECHS=python,java,spring boot,angular,react,aws,kubernetes,docker,apache nifi,jenkins,postgresql,typescript
# Roles que te interesan (se matchean contra el título)
PROFILE_ROLES=full stack,backend,tech lead,software engineer,ingeniero

# Idiomas: nivel propio y si lo consideras excluyente cuando la oferta lo pide
PROFILE_LANGUAGES=español nativo,inglés B2
PROFILE_ENGLISH_LEVEL=B2

# Preferencias de trabajo (afectan el score)
PROFILE_MODALITY_PREFERENCE=remoto,híbrido,presencial   # orden de preferencia
PROFILE_MOD_REMOTO_BONUS=3
PROFILE_MOD_HIBRIDO_BONUS=0
PROFILE_MODALIDAD_PRESENCIAL_PENALTY=-4

# Salario esperado (CLP mensual líquido). Ofertas con salario declarado
# dentro del rango ganan bonus; fuera del rango, penalización suave.
PROFILE_SALARY_MIN=2500000
PROFILE_SALARY_MAX=3200000
PROFILE_SALARY_FLEX=true            # true: fuera de rango solo baja un poco

# Ubicaciones aceptadas (regex separadas por coma; vacío = cualquier)
PROFILE_LOCATIONS_ACCEPTED=chile,remoto,santiago,temuco,valdivia,concepcion,la serena
PROFILE_LOCATIONS_REJECTED=extranjero,solo colombia,solo argentina

# Señales que TE INTERESAN (green flags)
PROFILE_GREEN_KEYWORDS=sin título requerido,horario flexible,primer empleo,remoto total,contratación directa
# Señales que RECHAZAS (red flags / black-list por keyword, case-insensitive)
PROFILE_RED_KEYWORDS=vendedor,ventas,comercial,call center,becario,pasantia,pasantía,trainee,practicante,sin experiencia,data entry,soporte técnico,helpdesk,qa manual,profesor,docente,intern
# Agencias/staffing: penalizar o solo marcar
PROFILE_STAFFING_PENALTY=-5

# ---------- SCORING (pesos del motor de afinidad) ----------
# Base al pasar filtros duros
SCORE_BASE=40
# Techs primarias (las primeras N_TECH_PRIMARY del PROFILE_TECHS) valen más
N_TECH_PRIMARY=4
SCORE_TECH_PRIMARY=15
SCORE_TECH_SECONDARY=8
# Roles en título
SCORE_ROLE_KEYWORDS=tech lead:14,lead:10,senior:8,full stack:12,fullstack:12
# Experiencia: años que pide la oferta vs PROFILE_YEARS_EXP
SCORE_EXP_MATCH_BONUS=2
SCORE_EXP_MISMATCH_SOFT=-3
SCORE_EXP_MISMATCH_HARD=-8
SCORE_EXP_HARD_THRESHOLD=8
# Inglés
SCORE_ENGLISH_EXCLUYENTE=-6
SCORE_ENGLISH_DESEABLE=0
SCORE_ENGLISH_NOT_REQUIRED=2
# Horario de otro hemisferio
SCORE_US_HOURS_PENALTY=-4
# Modalidad (usa PROFILE_MODALITY_* de arriba)
# Salario declarado
SCORE_SALARY_IN_RANGE_BONUS=5
SCORE_SALARY_OUT_SOFT=-2
# Techs de la descripción que solapan con tu stack
SCORE_STACK_OVERLAP_PER=1.5
SCORE_STACK_OVERLAP_MAX=6
# Score máximo
SCORE_CAP=98

# ---------- ALERTAS (qué llega a Telegram) ----------
# Umbral mínimo de score para notificar
ALERT_MIN_SCORE=70
# Máximo de ofertas por digest
ALERT_MAX_PER_DIGEST=10
# Si ninguna supera este score, mensaje "nada que valga la pena"
ALERT_WORTH_IT_SCORE=60

# ---------- BÚSQUEDAS ----------
# Modo: profile (solo perfil), sample (solo muestreo), both (default)
SEARCH_MODE=both
# Queries por plataforma (coma = query nueva). SEARCH_MODE amplía estas con SAMPLE_*
QUERIES_LINKEDIN=full stack python,software engineer python,tech lead,backend python aws
QUERIES_COMPUTRABAJO=python,programador-full-stack,desarrollador
QUERIES_INDEED=python,full stack,tech lead
QUERIES_GLASSDOOR=python,full stack
# Muestreo amplio (stats de mercado, sin filtro de perfil)
SAMPLE_QUERIES_LINKEDIN=desarrollador,programador,analista programador,ingeniero informatico,backend,frontend,devops,data engineer,qa automation,mobile
SAMPLE_QUERIES_INDEED=python,java,desarrollador,full stack,frontend,backend
SAMPLE_QUERIES_COMPUTRABAJO=programador,desarrollador,ingeniero,analista,web,qa
SAMPLE_QUERIES_GLASSDOOR=python,full stack,data,devops
# Fracción del pool de muestreo que corre por barrido (1 = todo)
SAMPLE_ROTATION=0.33

# ---------- FUENTES ----------
ENABLE_LINKEDIN=true
ENABLE_COMPUTRABAJO=true
ENABLE_INDEED=true
ENABLE_GLASSDOOR=true
# Glassdoor corre solo en ticks premium (ver run.sh)
PREMIUM_TICK_HOURS_UTC=00,12

# ---------- BATCH IA (deepseek-v4-flash vía ollama-cloud) ----------
IA_ENABLED=true
IA_MODEL=deepseek-v4-flash
IA_BASE_URL=https://ollama.com/v1
IA_API_KEY=   # pega aquí tu api key (OpenAI-compatible: ollama cloud, openai, deepseek, etc)
IA_BATCH_SIZE=40
IA_TIMEOUT=120
IA_RETRIES=1
IA_RUN_HOURS_UTC=03        # 00:00 Chile (post-barrido premium)
# --- IA local (spec-ia-local v2.1) — opt-in; false = cloud como siempre ---
IA_LOCAL_ENABLED=false
IA_LOCAL_BASE_URL=http://localhost:11434/v1
IA_LOCAL_MODEL=madkoding/ornith-1.5-9b-iq2m:latest
IA_LOCAL_TIMEOUT=600
IA_LOCAL_RETRIES=1
IA_LOCAL_FALLBACK_CLOUD=true
IA_LOCAL_CONCURRENCY=2

# ---------- TELEGRAM ----------
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_DIGEST_PAGE_SIZE=5

# ---------- SCHEDULING ----------
# Cron sugerido (lo instala el usuario o systemd timer)
CRON_EVERY_HOURS=4
# ============ DAEMON (modo watch) ============
# Minutos entre barridos del cron interno del modo daemon (default 240 = 4h)
DAEMON_INTERVAL_MIN=240

# IDs de chats donde el bot puede leer/escribir (lista separada por comas).
# El bot IGNORA cualquier mensaje/callback de chats fuera de esta lista.
# Placeholders — reemplaza por tus IDs reales (los grupos suelen ser -100XXXXXXXXXX).
TELEGRAM_ALLOWED_CHATS=-100XXXXXXXXXX,-100XXXXXXXXXX

# ---------- REPORT /market ----------
REPORT_ENABLED=true
REPORT_IA_NARRATIVE=true      # false = PDF solo con datos, sin llamadas IA
REPORT_MAX_SALARY_SAMPLES=60  # tope de ofertas de salario consideradas
REPORT_OUT_DIR=data/reports   # relativo al proyecto

# ---------- LABORUM (API searchV2, grupo Bumeran) ----------
ENABLE_LABORUM=true
QUERIES_LABORUM=python,desarrollador,full stack,backend,java,tech lead

# ---------- JOOBLE (API REST oficial — key en cl.jooble.org/api/about) ----------
ENABLE_JOOBLE=true
JOOBLE_API_KEY=                # gratuita, llega por email 1-2 días hábiles, 500 req lifetime
QUERIES_JOOBLE=python,desarrollador full stack,backend,java,tech lead

# ---------- ACCENTURE (API pública findjobs, sin key) ----------
ENABLE_ACCENTURE=true
QUERIES_ACCENTURE=fullstack,python,tech lead
# (v2) queries extra de cobertura: data, devops, react
QUERIES_LINKEDIN=data engineer,devops
QUERIES_COMPUTRABAJO=data-engineer,devops
QUERIES_INDEED=data engineer,devops,react
QUERIES_GLASSDOOR=data engineer,devops
QUERIES_LABORUM=data engineer,react
QUERIES_JOOBLE=data engineer,machine learning
QUERIES_ACCENTURE=data engineer,machine learning

# ---------- AIRA (feeds JSON públicos de empleadores) ----------
ENABLE_AIRA=true
AIRA_FEEDS=walmart,cencosud_scotiabank,tottus,entel,ripley,itau,bancoestado,wom,codelco,copec,cencosud
# ---------- RELEVANCE FILTER (gate de entrada para feeds completos) ----------
RELEVANCE_MODE=hybrid            # keywords | ia | hybrid | off
RELEVANCE_AREAS_TECH=data|digital|tecnolog|software|informatic|sistemas
RELEVANCE_AREAS_NOUTECH=venta|b2c|logistica|produccion|manufactura|finanzas|contabilidad|recursos_humanos|servicios_generales|prevencion_de_riesgos
RELEVANCE_NOUNTECH=guardia|cajer[ao]|repositor|recepcionista|vendedor|operari[ao]|bodeguero|conductor|mozo|auxiliar|captador
RELEVANCE_IA_BATCH=30
